// An assigned value converts to the place's type; a compound assignment
// converts the operator's result back to it, as a cast would (§7.12).
struct Point {
    X: int;
    Y: float;
}

Assign(p: Point, l: long) {
    var b: byte = 1;
    var i = 0;
    var x = 0.5;
    i = l; //~ ERROR MR0203
    i = 2;
    x = 2;
    x += i;
    i += 1;
    i += l;
    i *= 1.5;
    b += 1;
    b +%= 255;
    var s = "";
    s += "x";
    s += 1; //~ ERROR MR0204
    var flag = true;
    flag &= false;
    flag += flag; //~ ERROR MR0204
    b++;
    i <<= 1;
    var q = p;
    q.X = "x"; //~ ERROR MR0203
    let y: float = p.Y + 1;
    let z: int = p.Y; //~ ERROR MR0203
    let w = p with { X = 1.5 }; //~ ERROR MR0203
}

// A compound assignment is named as written, and only its value is cast.
Mixed(l: long) {
    var u = 1ul;
    u += l; //~ ERROR MR0204
}

// A cast cannot make an integer-only operator work on a `float`.
Bits(f: float, l: long) {
    var g = f;
    g &= l; //~ ERROR MR0204
    let h = l | f; //~ ERROR MR0204
}
