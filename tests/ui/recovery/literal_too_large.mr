// A literal too large for its type keeps the type expected at its
// position (§14.5, D-159), so a later mistake in the same body is
// reported too.
let big: double = 1e400; //~ ERROR MR0010
let label: string = big; //~ ERROR MR0203
let small: byte = 300; //~ ERROR MR0010
let name: string = small; //~ ERROR MR0203
