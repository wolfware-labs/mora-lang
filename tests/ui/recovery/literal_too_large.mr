// A literal too large for its type is reported once, and the local keeps
// its declared type (§14.5), so a later mistake in the same body is
// reported too.
let big: double = 1e400; //~ ERROR MR0010
let label: string = big; //~ ERROR MR0203
let small: byte = 300; //~ ERROR MR0010
let name: string = small; //~ ERROR MR0203
