// An interface has no fields, destructors or nested types, and its static
// members are `static abstract`. An extension adds only methods and
// getters. In an interface, a member with a value is a field; without one,
// it is a getter.
public interface IShape {
    Sides: int;
    Name: string => "shape";
    static abstract Unit: IShape;
    static abstract Default: IShape => Unit;
    type Part : IShape;

    Corners: int = 4; //~ ERROR MR0115
    static Count: int = 0; //~ ERROR MR0115
    ~IShape() {} //~ ERROR MR0115
    static Make(): int => 0; //~ ERROR MR0115
    static Zero: int => 0; //~ ERROR MR0115
    struct Side {} //~ ERROR MR0115
}

public struct Point {
    public X: int;
}

extension(p: Point) {
    public Twice: int => p.X * 2;
    public Shifted(by: int): int => p.X + by;

    Limit: int = 10; //~ ERROR MR0115
    mut Seen: int; //~ ERROR MR0115
    static Made: int = 0; //~ ERROR MR0115
    ~Point() {} //~ ERROR MR0115
    public static Origin(): Point => new Point { X = 0 }; //~ ERROR MR0115
    public static Zero: int => 0; //~ ERROR MR0115
    public static operator +(a: Point, b: Point): Point => a; //~ ERROR MR0115
    public this[i: int]: int => p.X + i; //~ ERROR MR0115
    type Unit = int; //~ ERROR MR0115
    enum Axis { X, Y } //~ ERROR MR0115
}

// `const` on a field there is `MR0113` alone.
extension(p: Point) {
    const Max: int = 10; //~ ERROR MR0113
    const static Min: int = 0; //~ ERROR MR0113
}

// A union's data lives in its cases; its constants and static fields are
// its own.
public union Shape {
    Circle(Radius: double),
    Square(Side: double);

    public const Sides: int = 4;
    public static Made: int = 0;
    public Name: string => "shape";

    Color: string = "black"; //~ ERROR MR0115
    public mut Seen: int; //~ ERROR MR0115
}

// A non-abstract static indexer is a static member like any other, and a
// macro is declared in a namespace.
public interface IGrid {
    static abstract this[i: int]: int { get; }
    static this[i: int]: int { get => i; } //~ ERROR MR0115
    // `const` on its accessor names the indexer's own rule.
    static this[i: int, j: int]: int { const get => i + j; } //~ ERROR MR0115 //~ ERROR MR0113
    macro Grid(t: Type) {} //~ ERROR MR0115
}

public struct Cell {
    macro Wrap(t: Type) {} //~ ERROR MR0115
}

extension(c: Cell) {
    macro Each(t: Type) {} //~ ERROR MR0115
}

macro Mark(t: Type) {}

// Without `const`, each member would still be one that cannot be there,
// so `MR0113` gets no fix and says why.
public interface IKeyed {
    const ~IKeyed() {} //~ ERROR MR0113
    const struct Key {} //~ ERROR MR0113
    const static Make(): int => 0; //~ ERROR MR0113
}

extension(c: Cell) {
    const this[i: int]: int { get => i; } //~ ERROR MR0113
    const type Item = int; //~ ERROR MR0113
    this[i: int]: int { const get => i; } //~ ERROR MR0115 //~ ERROR MR0113
}
