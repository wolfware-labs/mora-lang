// Memberwise creation needs every field without an initializer visible,
// and assigns only fields the expression can see.
public struct Account {
    public Owner: string;
    private Balance: int;
}

public struct Settings {
    public Name: string;
    private Retries: int = 3;

    public static Defaults(): Settings => new Settings { Name = "default", Retries = 1 };
}

let a = new Account { Owner = "ana" }; //~ ERROR MR0144
let b = new Account { Owner = "ana", Balance = 10 }; //~ ERROR MR0144
let c = new Settings { Name = "x" };
let d = new Settings { Name = "x", Retries = 5 }; //~ ERROR MR0129
