 /// The operand of a prefix operator, `await` or a cast, one level deeper.
 fn operand(p: &mut Parser<'_>, propagate: bool) -> Option<CompletedMarker> {
     p.nested(|p| unary_with(p, propagate)).unwrap_or_else(Some)
 }
 
