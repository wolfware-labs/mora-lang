// A constructor call assigns the fields itself; the names after it are
// plain assignments of fields visible here, and a type without a
// constructor takes no arguments.
public struct Sized {
    public mut Size: int;
    private mut Hidden: int;

    public Sized(size: int) {
        Size = size;
        Hidden = 0;
    }
}

public struct Plain {
    public N: int;
}

let a = new Sized(1) { Size = 2, Size = 3 };
let b = new Sized(1) { Szie = 2 }; //~ ERROR MR0147
let c = new Sized(1) { Hidden = 2 }; //~ ERROR MR0129
let d = new Plain(1); //~ ERROR MR0205
