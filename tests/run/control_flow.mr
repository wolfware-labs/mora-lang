// expect: small
// expect: 0 1 2 4
// expect: 6
// expect: 3
// expect: 1
let n = 3;
if (n > 10) {
    Console.WriteLine("large");
} else if (n > 1) {
    Console.WriteLine("small");
} else {
    Console.WriteLine("tiny");
}

var line = "";
for (var i = 0; i < 6; i++) {
    if (i == 3) {
        continue;
    }
    if (i == 5) {
        break;
    }
    line = i == 0 ? $"{i}" : $"{line} {i}";
}
Console.WriteLine(line);

var sum = 0;
var k = 1;
while (k <= 3) {
    sum += k;
    k++;
}
Console.WriteLine(sum);

var steps = 0;
do {
    steps++;
} while (steps < 3);
Console.WriteLine(steps);

var once = 0;
do {
    once++;
} while (false);
Console.WriteLine(once);
